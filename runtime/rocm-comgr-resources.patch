+// The existing compiler VFS already owns device libraries. Keep supplied source/headers there
+// too; only generated GPU objects/images need real files for the original linker pipeline.
+static amd_comgr_status_t stageInput(DataObject *Object, StringRef Path,
+                                    vfs::InMemoryFileSystem *FS) {
+  if (Path.empty()) return AMD_COMGR_STATUS_ERROR_INVALID_ARGUMENT;
+  if (!FS)
+    return outputToFile(Object, Path);
+  return FS->addFile(Path, 0, MemoryBuffer::getMemBufferCopy(
+                                StringRef(Object->Data, Object->Size), Path))
+             ? AMD_COMGR_STATUS_SUCCESS : AMD_COMGR_STATUS_ERROR;
+}
