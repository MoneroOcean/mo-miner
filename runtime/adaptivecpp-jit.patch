@@ -33,6 +34,23 @@ inline std::vector<std::string> split_by_delimiter(const std::string &str, char
   return result;
 }
 
+// ELF treats '@' as a version separator; PTX rejects MSVC punctuation. Encode the complete
+// name injectively; reserve the prefix too so an existing safe name cannot collide.
+// Preserve the established AMD spelling; only final Windows images and SSCP lookups map it.
+inline std::string device_symbol_name(std::string_view name) {
+  constexpr std::string_view prefix = "__acpp_elf_";
+  if(name.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.$") ==
+         std::string_view::npos && name.substr(0, prefix.size()) != prefix)
+    return std::string{name};
+  std::string result{prefix};
+  constexpr char digits[] = "0123456789abcdef";
+  for(unsigned char byte : name) {
+    result += digits[byte >> 4];
+    result += digits[byte & 15];
+  }
+  return result;
+}
+
 }
 }
 
