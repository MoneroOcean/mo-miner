diff --git a/include/hipSYCL/runtime/cuda/cuda_driver.hpp b/include/hipSYCL/runtime/cuda/cuda_driver.hpp
new file mode 100644
index 0000000..30edb6f
--- /dev/null
+++ b/include/hipSYCL/runtime/cuda/cuda_driver.hpp
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: BSD-2-Clause
+#pragma once
+
+#include <cuda_runtime_api.h>
+#include <cuda.h>
+#include <cudaTypedefs.h>
+
+namespace hipsycl { namespace rt { namespace cuda_driver {
+
+#ifdef ACPP_STATIC_RUNTIME
+// The linked CUDA runtime already owns optional system-driver discovery. Ask it for the exact
+// stable ABI of these four calls instead of creating a mandatory libcuda/NVCUDA import. Cache
+// each lookup for the process lifetime, never retry or dereference an absent/error entrypoint.
+template <typename Function>
+Function resolve(const char *name, unsigned version) {
+  void *entry = nullptr;
+  cudaDriverEntryPointQueryResult status = cudaDriverEntryPointSymbolNotFound;
+  if (cudaGetDriverEntryPointByVersion(name, &entry, version, cudaEnableLegacyStream, &status)
+          != cudaSuccess || status != cudaDriverEntryPointSuccess) {return nullptr;}
+  return reinterpret_cast<Function>(entry);
+}
+
+#define ACPP_CUDA_DRIVER_CALL(name, version) \
+  template <typename... Args> inline CUresult name(Args... args) { \
+    static const auto function = resolve<PFN_##name##_v##version>(#name, version); \
+    return function ? function(args...) : CUDA_ERROR_NOT_INITIALIZED; \
+  }
+ACPP_CUDA_DRIVER_CALL(cuModuleLoadDataEx, 2010)
+ACPP_CUDA_DRIVER_CALL(cuModuleUnload, 2000)
+ACPP_CUDA_DRIVER_CALL(cuModuleGetFunction, 2000)
+ACPP_CUDA_DRIVER_CALL(cuLaunchKernel, 4000)
+#undef ACPP_CUDA_DRIVER_CALL
+#else
+// Engineering/shared builds retain their existing direct driver calls and link policy.
+using ::cuModuleLoadDataEx;
+using ::cuModuleUnload;
+using ::cuModuleGetFunction;
+using ::cuLaunchKernel;
+#endif
+
+}}} // namespace hipsycl::rt::cuda_driver
