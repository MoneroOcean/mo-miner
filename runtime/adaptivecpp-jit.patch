+static bool makeDeterministicHcfObjectId(const llvm::Module &M,
+                                         llvm::StringRef Namespace,
+                                         std::string &HcfString,
+                                         std::size_t &HcfObjectId) {
+  llvm::StringRef ModuleId = M.getModuleIdentifier();
+  if(ModuleId.empty())
+    ModuleId = M.getSourceFileName();
+  if(ModuleId.empty()) {
+    M.getContext().emitError(
+        "deterministic HCF IDs require a non-empty module/source identifier");
+    return false;
+  }
+
+  const std::string Placeholder = "object-id=0\n";
+  if(HcfString.compare(0, Placeholder.size(), Placeholder) != 0) {
+    M.getContext().emitError(
+        "deterministic HCF IDs expected the canonical object-id placeholder");
+    return false;
+  }
+
+  llvm::SHA256 Hash;
+  const llvm::StringRef Separator{"\0", 1};
+  Hash.update(Namespace);
+  Hash.update(Separator);
+  Hash.update(ModuleId);
+  Hash.update(Separator);
+  Hash.update(llvm::StringRef(HcfString));
+  const auto Digest = Hash.final();
+
+  HcfObjectId = 0;
+  for(std::size_t I = 0; I < sizeof(HcfObjectId); ++I)
+    HcfObjectId = (HcfObjectId << 8) | Digest[I];
+  if(HcfObjectId == 0)
+    HcfObjectId = 1;
+
+  HcfString.replace(0, Placeholder.size(),
+                    "object-id=" + std::to_string(HcfObjectId) + "\n");
+  return true;
+}
