diff --git a/unified-runtime/source/loader/ur_adapter_registry.hpp b/unified-runtime/source/loader/ur_adapter_registry.hpp
index ca382c617..f107a17b4 100644
--- a/unified-runtime/source/loader/ur_adapter_registry.hpp
+++ b/unified-runtime/source/loader/ur_adapter_registry.hpp
@@ -175,6 +175,18 @@ public:
 
   bool adaptersForceLoaded() { return forceLoaded; }
 
+  // Static factories must honor the same parsed selector as dynamic discovery. Keep the
+  // manifest identities, not filesystem availability: a static adapter needs no DLL/SO.
+  bool isAdapterEnabled(const std::string &name) const {
+    return std::any_of(adaptersLoadPaths.begin(), adaptersLoadPaths.end(),
+                       [&name](const auto &paths) {
+                         return std::any_of(paths.begin(), paths.end(),
+                                            [&name](const auto &p) {
+                                              return p.filename() == name;
+                                            });
+                       });
+  }
+
   std::vector<std::vector<fs::path>>::const_iterator begin() const noexcept {
     return adaptersLoadPaths.begin();
   }
