@@ -60,6 +61,28 @@ namespace ze_lib
     }
     bool destruction = false;
 
+#if defined(MOM_EMBEDDED_LEVEL_ZERO) && defined(_WIN32)
+    // An executable never receives DllMain. Keep the full loader's two contexts alive
+    // for the application, with the same teardown order as its original DLL entrypoint.
+    // This TU also defines context, so the archive linker retains this constructor.
+    namespace {
+    struct EmbeddedContexts {
+        EmbeddedContexts() {
+            std::unique_ptr<context_t> lib(new context_t);
+            std::unique_ptr<loader::context_t> implementation(new loader::context_t);
+            context = lib.release();
+            loader::context = implementation.release();
+        }
+        ~EmbeddedContexts() {
+            delete context;
+            context = nullptr;
+            delete loader::context;
+            loader::context = nullptr;
+        }
+    } embeddedContexts;
+    }
+#endif
+
