+
+// MoM's final-link admission tag covers the actual embedded compiler/runtime closure.
+// No tag preserves upstream behavior; changing an initialized cache's identity is forbidden.
+extern "C" bool mom_acpp_set_appdb_cache_tag(const unsigned char *tag) noexcept {
+  if (!tag) return false;
+  try {
+    auto &state = mom_appdb_tag();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (state.started) return false;
+    if (state.set) return std::equal(state.bytes.begin(), state.bytes.end(), tag);
+    std::copy_n(tag, state.bytes.size(), state.bytes.begin());
+    state.set = true;
+    return true;
+  } catch (...) { return false; }
+}
