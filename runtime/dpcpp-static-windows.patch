+    }
+    return;
+#else
     std::optional<std::vector<std::string>> forceLoadedAdaptersOpt;
     try {
       forceLoadedAdaptersOpt = getenv_to_vec("UR_ADAPTERS_FORCE_LOAD");
@@ -136,6 +161,7 @@ public:
