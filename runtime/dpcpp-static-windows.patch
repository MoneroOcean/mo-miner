diff --git a/unified-runtime/cmake/helpers.cmake b/unified-runtime/cmake/helpers.cmake
--- a/unified-runtime/cmake/helpers.cmake
+++ b/unified-runtime/cmake/helpers.cmake
@@ -302,14 +302,14 @@
 function(ur_adapter_is_static adapter out_var)
   set(static_var "UR_STATIC_ADAPTER_${adapter}")
   string(TOUPPER "${static_var}" static_var)
   string(TOUPPER "${adapter}" adapter)
-  # Special case: LEVEL_ZERO uses UR_STATIC_ADAPTER_L0
+  # Both original Level Zero versions share the static-L0 policy.
-  if(adapter STREQUAL "LEVEL_ZERO")
+  if(adapter STREQUAL "LEVEL_ZERO" OR adapter STREQUAL "LEVEL_ZERO_V2")
     set(static_var "UR_STATIC_ADAPTER_L0")
   endif()
   if(DEFINED ${static_var} AND ${static_var})
     set(${out_var} TRUE PARENT_SCOPE)
   else()
     set(${out_var} FALSE PARENT_SCOPE)
   endif()
 endfunction()
