 # LICENSE file in the root directory of this source tree.
 
+if(WIN32 AND CMAKE_CXX_COMPILER_ID STREQUAL "IntelLLVM")
+  # Keep DateUtil's math on the standard CRT instead of compiler-private vector helpers.
+  # Other Hermes sources and all non-Intel/non-Windows builds retain their optimization.
+  set_property(SOURCE JSLib/DateUtil.cpp APPEND PROPERTY COMPILE_OPTIONS -fno-builtin)
+endif()
