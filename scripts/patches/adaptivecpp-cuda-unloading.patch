diff --git a/src/runtime/cuda/cuda_allocator.cpp b/src/runtime/cuda/cuda_allocator.cpp
--- a/src/runtime/cuda/cuda_allocator.cpp
+++ b/src/runtime/cuda/cuda_allocator.cpp
@@ -63,7 +63,14 @@ void cuda_allocator::raw_free(void *mem) {
   pointer_info info;
   result query_result = query_pointer(mem, info);
 
   if (!query_result.is_success()) {
+    // Static SYCL allocations can be released after CUDA's atexit teardown. At that point the
+    // pointer cannot be queried or freed, and the runtime owns no live allocation to release.
+    // Suppress only CUDA's explicit already-unloaded result; retain unknown-pointer/live errors.
+    const auto code = query_result.info().error_code();
+    if (code.get_component() == "CUDA" && code.is_code_specified() &&
+        code.get_code() == cudaErrorCudartUnloading)
+      return;
     register_error(query_result);
     return;
   }
@@ -75,7 +82,7 @@ void cuda_allocator::raw_free(void *mem) {
   else
     err = cudaFree(mem);
   
-  if (err != cudaSuccess) {
+  if (err != cudaSuccess && err != cudaErrorCudartUnloading) {
     register_error(__acpp_here(),
                    error_info{"cuda_allocator: cudaFree() failed",
                               error_code{"CUDA", err},
diff --git a/src/runtime/cuda/cuda_queue.cpp b/src/runtime/cuda/cuda_queue.cpp
--- a/src/runtime/cuda/cuda_queue.cpp
+++ b/src/runtime/cuda/cuda_queue.cpp
@@ -256,9 +256,11 @@ CUstream_st* cuda_queue::get_stream() const { return _stream; }
 
 cuda_queue::~cuda_queue() {
   auto err = cudaStreamDestroy(_stream);
-  if (err != cudaSuccess) {
+  // Process-static SYCL queues can outlive CUDA's atexit teardown. Error 4 means the runtime is
+  // already unloaded and there is no live stream left to destroy; retain every other error.
+  if (err != cudaSuccess && err != cudaErrorCudartUnloading) {
     register_error(__acpp_here(),
                    error_info{"cuda_queue: Couldn't destroy stream",
                               error_code{"CUDA", err}});
   }
 }
@@ -508,10 +510,12 @@ result cuda_queue::wait() {
 
   auto err = cudaStreamSynchronize(_stream);
 
-  if(err != cudaSuccess) {
+  // Do not turn CUDA's already-unloaded process teardown into a spurious queue failure. This does
+  // not suppress launch, synchronization, or hardware errors from a live CUDA context.
+  if(err != cudaSuccess && err != cudaErrorCudartUnloading) {
     return make_error(__acpp_here(),
                       error_info{"cuda_queue: Couldn't synchronize with stream",
                                  error_code{"CUDA", err}});
   }
 
   return make_success();
diff --git a/src/runtime/cuda/cuda_event.cpp b/src/runtime/cuda/cuda_event.cpp
--- a/src/runtime/cuda/cuda_event.cpp
+++ b/src/runtime/cuda/cuda_event.cpp
@@ -33,8 +33,11 @@ bool cuda_node_event::is_complete() const
   cudaError_t err = cudaEventQuery(_evt);
-  if (err != cudaErrorNotReady && err != cudaSuccess) {
+  // A scheduler/event can be torn down after CUDA's own atexit handler. There is no live event to
+  // query once cudart reports that it is unloaded; retain all live-runtime failures.
+  if (err != cudaErrorNotReady && err != cudaSuccess &&
+      err != cudaErrorCudartUnloading) {
     register_error(__acpp_here(),
                    error_info{"cuda_node_event: Couldn't query event status",
                               error_code{"CUDA", err}});
   }
-  return err == cudaSuccess;
+  return err == cudaSuccess || err == cudaErrorCudartUnloading;
 }
@@ -44,7 +47,7 @@ void cuda_node_event::wait()
   auto err = cudaEventSynchronize(_evt);
-  if (err != cudaSuccess) {
+  if (err != cudaSuccess && err != cudaErrorCudartUnloading) {
     register_error(__acpp_here(),
                    error_info{"cuda_node_event: cudaEventSynchronize() failed",
                               error_code{"CUDA", err}});
   }
 }
diff --git a/src/runtime/cuda/cuda_event_pool.cpp b/src/runtime/cuda/cuda_event_pool.cpp
--- a/src/runtime/cuda/cuda_event_pool.cpp
+++ b/src/runtime/cuda/cuda_event_pool.cpp
@@ -39,7 +39,9 @@ result cuda_event_factory::destroy(cudaEvent_t evt) {
   auto err = cudaEventDestroy(evt);
-  if (err != cudaSuccess) {
+  // Pooled events are process-static and may outlive cudart. Error 4 means there is no live event
+  // left to destroy; every failure while the runtime is still present remains an error.
+  if (err != cudaSuccess && err != cudaErrorCudartUnloading) {
     return make_error(__acpp_here(),
                    error_info{"cuda_event_factory: Couldn't destroy event",
                               error_code{"CUDA", err}});
   }
   return make_success();
